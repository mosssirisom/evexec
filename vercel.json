{
  "version": 2,
  "framework": null,
  "builds": [
    { "src": "api/booking/index.js", "use": "@vercel/node" },
    { "src": "api/operator/index.js", "use": "@vercel/node" },
    { "src": "api/payment/index.js", "use": "@vercel/node", "config": {"helpers": false} },
    { "src": "api/account/index.js", "use": "@vercel/node" },
    { "src": "api/notifications/index.js", "use": "@vercel/node" },
    { "src": "api/leads.js", "use": "@vercel/node" },
    { "src": "api/reminders/trigger.js", "use": "@vercel/node" },
    { "src": "api/flight/reverify.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.xml", "use": "@vercel/static" },
    { "src": "*.txt", "use": "@vercel/static" },
    { "src": "favicon.ico", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*)", "continue": true, "headers": {"X-Content-Type-Options": "nosniff", "X-Frame-Options": "SAMEORIGIN", "Content-Security-Policy": "frame-ancestors 'self'", "Referrer-Policy": "strict-origin-when-cross-origin", "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(self \"https://js.stripe.com\")"} },
    { "src": "/index\\.html", "status": 308, "headers": {"Location": "/"} },
    { "src": "/((?!api/|public/).+)\\.html", "status": 308, "headers": {"Location": "/$1"} },
    { "src": "/((?!api/).+)/", "status": 308, "headers": {"Location": "/$1"} },
    { "src": "/(booking|account)", "headers": {"X-Robots-Tag": "noindex"}, "continue": true },
    { "src": "/(.*)", "has": [{"type": "host", "value": "evexec.vercel.app"}], "headers": {"X-Robots-Tag": "noindex"}, "continue": true },
    { "src": "/api/booking/(.*)", "dest": "/api/booking/index.js" },
    { "src": "/api/operator/(.*)", "dest": "/api/operator/index.js" },
    { "src": "/api/payment/(.*)", "dest": "/api/payment/index.js" },
    { "src": "/api/account/(.*)", "dest": "/api/account/index.js" },
    { "src": "/api/notifications/(.*)", "dest": "/api/notifications/index.js" },
    { "src": "/api/(leads|admin-leads|contact|quote-request|update-status)", "dest": "/api/leads.js" },
    { "src": "/api/reminders/trigger", "dest": "/api/reminders/trigger.js" },
    { "src": "/api/flight/reverify", "dest": "/api/flight/reverify.js" },
    { "src": "/api/config", "dest": "/api/booking/index.js" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/booking", "dest": "/booking.html" },
    { "src": "/account", "dest": "/account.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/manchester-airport-transfer-blackpool", "dest": "/manchester-airport-transfer-blackpool.html" },
    { "src": "/liverpool-airport-transfer-blackpool", "dest": "/liverpool-airport-transfer-blackpool.html" },
    { "src": "/leeds-bradford-airport-transfer-blackpool", "dest": "/leeds-bradford-airport-transfer-blackpool.html" },
    { "src": "/airport-transfer-lytham-st-annes", "dest": "/airport-transfer-lytham-st-annes.html" },
    { "src": "/airport-transfer-poulton-le-fylde", "dest": "/airport-transfer-poulton-le-fylde.html" },
    { "src": "/airport-transfer-fleetwood", "dest": "/airport-transfer-fleetwood.html" },
    { "src": "/airport-transfer-kirkham", "dest": "/airport-transfer-kirkham.html" },
    { "src": "/airport-transfer-preston", "dest": "/airport-transfer-preston.html" },
    { "src": "/blog", "dest": "/blog.html" },
    { "src": "/manchester-airport-parking-vs-private-transfer", "dest": "/manchester-airport-parking-vs-private-transfer.html" },
    { "src": "/airport-transfers", "dest": "/airport-transfers.html" },
    { "src": "/areas", "dest": "/areas.html" },
    { "src": "/fleet", "dest": "/fleet.html" },
    { "src": "/faq", "dest": "/faq.html" },
    { "src": "/quote", "dest": "/quote.html" },
    { "src": "/corporate-travel", "dest": "/corporate-travel.html" },
    { "src": "/private-hire", "dest": "/private-hire.html" },
    { "src": "/long-distance-transfers", "dest": "/long-distance-transfers.html" },
    { "src": "/event-transfers", "dest": "/event-transfers.html" },
    { "src": "/prices", "dest": "/prices.html" },
    { "src": "/reviews", "dest": "/reviews.html" },
    { "src": "/airport-transfer-freckleton", "status": 301, "headers": {"Location": "/airport-transfer-kirkham"} },
    { "src": "/airport-transfer-warton", "status": 301, "headers": {"Location": "/airport-transfer-kirkham"} },
    { "src": "/executive-airport-transfers-blackpool", "status": 301, "headers": {"Location": "/corporate-travel"} },
    { "src": "/airport-transfer-thornton-cleveleys", "status": 301, "headers": {"Location": "/airport-transfer-fleetwood"} },
    { "src": "/manchester-airport-transfers-from-blackpool", "status": 301, "headers": {"Location": "/manchester-airport-transfer-blackpool"} },
    { "src": "/airport-transfer-birmingham-blackpool", "status": 301, "headers": {"Location": "/airport-transfers"} },
    { "src": "/account-premium", "status": 301, "headers": {"Location": "/account"} },
    { "src": "/public/(.*)", "dest": "/public/$1" },
    { "src": "/", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "status": 404, "dest": "/404.html" }
  ],
  "crons": [
    { "path": "/api/reminders/trigger", "schedule": "0 8 * * *" },
    { "path": "/api/notifications/retry", "schedule": "0 8 * * *" },
    { "path": "/api/flight/reverify", "schedule": "0 7 * * *" }
  ]
}
